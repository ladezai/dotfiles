theme=dark:Catppuccin Mocha,light:Catppuccin Latte
shell-integration=zsh

font-size=16

mouse-hide-while-typing=true
macos-titlebar-style=native
macos-icon=retro

window-padding-x=2
window-padding-y=2
window-theme=ghostty
window-decoration=true
background-opacity=1.0

custom-shader = cursor_smear_fade.glsl
custom-shader = ripple_rectangle_cursor.glsl

keybind=cmd+k=scroll_page_fractional:-0.5
keybind=cmd+j=scroll_page_fractional:0.5
# Opens the path of the file in nvim 
keybind=cmd+shift+o=text:\x1bsv-clip\x0d
env=COLORTERM=truecolor
